# Base de datos (Usuario de migración / propietario para Flyway)
DB_HOST=localhost
DB_PORT=5440
DB_NAME=cuentaclara
DB_ADMIN_USER=cuentaclara_owner
DB_ADMIN_PASSWORD=owner_secret_dev

# Usuario de la aplicación sin privilegios de dueño (Sujeto a Row Level Security - RNF-01)
DB_APP_USER=cuentaclara_app
DB_APP_PASSWORD=app_secret_dev

# Redis (Cola de procesamiento asíncrono)
