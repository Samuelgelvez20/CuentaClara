# Base de datos (Usuario de migración / propietario para Flyway)
DB_HOST=localhost
DB_PORT=5440
DB_NAME=cuentaclara
DB_SSLMODE=disable
DB_ADMIN_USER=cuentaclara_owner
DB_ADMIN_PASSWORD=owner_secret_dev

# Usuario de la aplicación sin privilegios de dueño (Sujeto a Row Level Security - RNF-01)
DB_APP_USER=cuentaclara_app
DB_APP_PASSWORD=app_secret_dev

# Redis (Cola de procesamiento asíncrono)
REDIS_HOST=localhost
REDIS_PORT=6380

# ClamAV (Escaneo antivirus RNF-03)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# Seguridad JWT (RNF-02) & Google Sign-In (RF-01)
JWT_SECRET=c3VwZXItc2VjcmV0LWtleS1mb3ItY3VlbnRhY2xhcmEtZGV2LW1pbmltdW0tMzItYnl0ZXM=
JWT_EXPIRATION_MINUTES=30
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
